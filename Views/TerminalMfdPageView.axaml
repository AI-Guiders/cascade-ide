<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CascadeIDE.ViewModels"
             xmlns:feat="using:CascadeIDE.Features.Instrumentation"
             xmlns:term="using:CascadeIDE.Features.Terminal"
             xmlns:views="using:CascadeIDE.Views"
             xmlns:terminal="using:AvaloniaTerminal"
             x:Class="CascadeIDE.Views.TerminalMfdPageView"
             x:DataType="vm:MainWindowViewModel">
    <DockPanel>
        <Border DockPanel.Dock="Top" IsVisible="{Binding IdeHealthOnTerminalTab}" Classes="modeCard" Margin="0,0,0,4">
            <StackPanel Spacing="4">
                <WrapPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding IdeHealthBuildText}" Foreground="{DynamicResource CascadeTheme.TerminalForeground}" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding ResultSummary}"
                               IsVisible="{Binding IsResultSummaryVisible}"
                               Foreground="{DynamicResource CascadeTheme.TerminalForeground}" Margin="0,0,12,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding RiskSummary}"
                               IsVisible="{Binding IsRiskSummaryVisible}"
                               Foreground="{DynamicResource CascadeTheme.TerminalForeground}" Margin="0,0,12,0" MaxWidth="320" TextTrimming="CharacterEllipsis"/>
                </WrapPanel>
                <StackPanel DataContext="{Binding InstrumentationPanel}" x:DataType="feat:InstrumentationPanelViewModel" Spacing="0">
                    <TextBlock Text="События появятся при работе агента и сборке."
                               IsVisible="{Binding !HasEventTimeline}"
                               Foreground="{DynamicResource CascadeTheme.TerminalForeground}"
                               FontSize="11"
                               Margin="0,0,0,4"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  IsVisible="{Binding HasEventTimeline}">
                        <ItemsControl ItemsSource="{Binding EventTimeline}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Foreground="{DynamicResource CascadeTheme.TerminalForeground}" FontSize="11" Margin="0,0,10,0"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </StackPanel>
        </Border>
        <DockPanel DataContext="{Binding TerminalPanel}" x:DataType="term:TerminalPanelViewModel">
            <views:PanelChromeHeader DockPanel.Dock="Top" Classes="terminal" Title="Консоль · интерактивная shell" UppercaseTitle="True"/>
            <Border x:Name="TerminalHostChrome"
                    MinHeight="96"
                    Background="{DynamicResource CascadeTheme.TerminalBackground}"
                    Padding="2">
                <terminal:TerminalControl x:Name="TerminalView"
                                          Model="{Binding TerminalModel}"
                                          FontFamily="{DynamicResource AvaloniaTerminalFontFamily}"
                                          FontSize="{DynamicResource AvaloniaTerminalFontSize}"
                                          RightClickAction="CopyOrPaste"/>
            </Border>
        </DockPanel>
    </DockPanel>
</UserControl>

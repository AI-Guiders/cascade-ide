<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CascadeIDE.Views"
             xmlns:vm="using:CascadeIDE.ViewModels"
             x:Class="CascadeIDE.Views.WorkspaceChromeBandView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <views:EicasAlertsBarView Grid.Row="0"
                                  IsVisible="{Binding ShowEicasAlertsBar}"/>
        <StackPanel Grid.Row="1">
            <!-- Quiet dual-cockpit packing: agent organ name when no MFD page (0-sync). -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.72"
                       FontSize="11"
                       Text="{Binding AgentCabinChromeHint}"
                       IsVisible="{Binding ShowAgentCabinChromeHint}"/>
            <!-- L1 pressure continuity pulse (pressure-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentPressureChromeHint}"
                       IsVisible="{Binding ShowAgentPressureChromeHint}"/>
            <!-- AutoIgnition continuity pulse (ignite-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentIgniteChromeHint}"
                       IsVisible="{Binding ShowAgentIgniteChromeHint}"/>
            <!-- Project Switch PRIMARY/SCOPE (scope-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentScopeChromeHint}"
                       IsVisible="{Binding ShowAgentScopeChromeHint}"/>
            <!-- Sys ops pulse (sys-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentSysChromeHint}"
                       IsVisible="{Binding ShowAgentSysChromeHint}"/>
            <!-- Onboard cold-start pulse (onboard-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentOnboardChromeHint}"
                       IsVisible="{Binding ShowAgentOnboardChromeHint}"/>
            <!-- Arch board pulse (arch-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentArchChromeHint}"
                       IsVisible="{Binding ShowAgentArchChromeHint}"/>
            <!-- MCP outlet pulse (mcp-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentMcpChromeHint}"
                       IsVisible="{Binding ShowAgentMcpChromeHint}"/>
            <!-- Task Manager pulse (plan-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentPlanChromeHint}"
                       IsVisible="{Binding ShowAgentPlanChromeHint}"/>
            <!-- Report board pulse (report-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2,8,0"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentReportChromeHint}"
                       IsVisible="{Binding ShowAgentReportChromeHint}"/>
            <!-- CRM awaiting pulse (crm-LATEST) — not EICAS. -->
            <TextBlock Margin="8,2"
                       Opacity="0.8"
                       FontSize="11"
                       Text="{Binding AgentCrmChromeHint}"
                       IsVisible="{Binding ShowAgentCrmChromeHint}"/>
        </StackPanel>
        <!-- Полоса Workspace Health: раньше выравнивалась по MainGrid; теперь зона — MFD, на всю ширину контейнера. -->
        <Grid Grid.Row="2" IsVisible="{Binding ShowIdeHealthStrip}">
            <views:WorkspaceHealthStripView/>
        </Grid>
    </Grid>
</UserControl>

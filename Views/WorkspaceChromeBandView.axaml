<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:CascadeIDE.Views"
             xmlns:vm="using:CascadeIDE.ViewModels"
             x:Class="CascadeIDE.Views.WorkspaceChromeBandView"
             x:DataType="vm:MainWindowViewModel">
    <Grid RowDefinitions="Auto,Auto,*">
        <views:EicasAlertsBarView Grid.Row="0"
                                  IsVisible="{Binding ShowEicasAlertsBar}"/>
        <StackPanel Grid.Row="1">
            <!-- SoftOrgan chrome density: top-N priority lines + overflow (latches stay latch-first). -->
            <ItemsControl ItemsSource="{Binding AgentChromeHintVisibleLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Margin="8,2,8,0"
                                   Opacity="0.8"
                                   FontSize="11"
                                   Text="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Margin="8,2"
                       Opacity="0.55"
                       FontSize="11"
                       Text="{Binding AgentChromeHintOverflow}"
                       IsVisible="{Binding ShowAgentChromeHintOverflow}"/>
        </StackPanel>
        <!-- Полоса Workspace Health: раньше выравнивалась по MainGrid; теперь зона — MFD, на всю ширину контейнера. -->
        <Grid Grid.Row="2" IsVisible="{Binding ShowIdeHealthStrip}">
            <views:WorkspaceHealthStripView/>
        </Grid>
    </Grid>
</UserControl>

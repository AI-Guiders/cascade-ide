<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- CDP: keep _scratch dirs out of compile (agent probes → TEMP via Scratch.*) -->
    <DefaultItemExcludes>$(DefaultItemExcludes);**/_*/**</DefaultItemExcludes>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.74.1" />
    <PackageReference Include="EasyWindowsTerminalControl" Version="1.0.38" />
    <PackageReference Include="Markdig" Version="1.1.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CascadeIDE.GlassCore\CascadeIDE.GlassCore.csproj" />
  </ItemGroup>

</Project>

<UserControl x:Class="CDP.GlassCockpit.Windows.GlassMfdProcessHosts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:CDP.GlassCockpit.Windows">
  <Grid>
    <Border x:Name="MfdTerminalHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="TerminalRestartBtn" DockPanel.Dock="Right" Content="restart" Padding="8,2" Margin="8,0,0,0"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="TerminalShellLabel" Text="vt · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <!-- Avalonia EOL · Glass cabin = WPF: ready WT terminal (EasyWindowsTerminalControl). -->
        <!-- No StartupCommandLine here: Loaded while Collapsed starts ConPTY at 0×0 (no input). MainWindow starts after layout + Focus. -->
        <term:EasyTerminalControl x:Name="TerminalVt"
                                  Focusable="True"
                                  FontFamilyWhenSettingTheme="Cascadia Code"
                                  FontSizeWhenSettingTheme="12"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdBuildHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BuildRunBtn" Content="build" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="BuildCancelBtn" Content="cancel" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="BuildClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="BuildStatusLabel" Text="redirected · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="BuildOutput" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdTestsHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="TestsRunBtn" Content="test" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="TestsCancelBtn" Content="cancel" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="TestsClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="TestsStatusLabel" Text="redirected · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="TestsOutput" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdGitHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="GitStatusBtn" Content="refresh" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitCancelBtn" Content="cancel" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="GitStatusLabel" Text="git · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="1.4*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="GitList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                   DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          <TextBox x:Name="GitOutput" Grid.Column="2" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"
                   HorizontalScrollBarVisibility="Auto"
                   Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                   FontFamily="Consolas" FontSize="12"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdProblemsHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="ProblemsRefreshBtn" Content="refresh" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="ProblemsClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="ProblemsStatusLabel" Text="0 ошиб., 0 предупр."
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="ProblemsList" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,4" Padding="10,7,10,8" CornerRadius="5"
                      BorderThickness="1" BorderBrush="#22FFFFFF" Background="#12000000">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#D7A33C"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#E05858"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding HeaderLine}" FontFamily="Consolas" FontSize="11.5"
                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#E8E8E8"/>
                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                               Foreground="#AAAAAA" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Border x:Name="MfdRelatedFilesHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="RelatedRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="RelatedStatusLabel" Text="related · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <ListBox x:Name="RelatedList" Background="Transparent" BorderThickness="0"
                 DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdSemanticMapHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="SemanticRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="SemanticStatusLabel" Text="semantic · skia graph"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#101010" BorderBrush="#2A2A2A" BorderThickness="1">
            <local:GlassSemanticMapSkia x:Name="SemanticSkia"/>
          </Border>
          <ListBox Grid.Column="2" x:Name="SemanticList" Background="Transparent" BorderThickness="0"
                   DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdCorrespondenceHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="CorrespondenceRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="CorrespondenceStatusLabel" Text="crs · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="reverse · code" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="CorrespondenceReverseList" Background="Transparent" BorderThickness="0"
                     DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="forward · docs" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="CorrespondenceForwardList" Background="Transparent" BorderThickness="0"
                     DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdMarkdownHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="MarkdownRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="MarkdownStatusLabel" Text="markdown · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBox x:Name="MarkdownOutput" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdDebugStackHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="DebugRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="DebugStatusLabel" Text="debug · spectator · no session"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="stack" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="DebugStackList" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="locals" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="DebugLocalsList" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdWebAiHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="WebAiGoBtn" DockPanel.Dock="Right" Content="go" Padding="8,2" Margin="8,0,0,0"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBox x:Name="WebAiUrl" Padding="6,4"
                   Background="#1A1A1A" Foreground="#EEE" BorderBrush="#3A3A3A"
                   FontFamily="Consolas" FontSize="12"
                   Text="https://chatgpt.com"/>
        </DockPanel>
        <TextBlock x:Name="WebAiStatusLabel" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                   Text="webai · WebView2 · idle"
                   FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
        <wv2:WebView2 x:Name="WebAiView" DefaultBackgroundColor="#121212"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

<UserControl x:Class="CDP.GlassCockpit.Windows.GlassMfdProcessHosts"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:term="clr-namespace:EasyWindowsTerminalControl;assembly=EasyWindowsTerminalControl"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             xmlns:local="clr-namespace:CDP.GlassCockpit.Windows">
  <Grid>
    <Border x:Name="MfdTerminalHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="TerminalRestartBtn" DockPanel.Dock="Right" Content="restart" Padding="8,2" Margin="8,0,0,0"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="TerminalShellLabel" Text="vt · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <!-- Avalonia EOL · Glass cabin = WPF: ready WT terminal (EasyWindowsTerminalControl). -->
        <!-- No StartupCommandLine here: Loaded while Collapsed starts ConPTY at 0×0 (no input). MainWindow starts after layout + Focus. -->
        <term:EasyTerminalControl x:Name="TerminalVt"
                                  Focusable="True"
                                  FontFamilyWhenSettingTheme="Cascadia Code"
                                  FontSizeWhenSettingTheme="12"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdBuildHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="BuildRunBtn" Content="build" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="BuildCancelBtn" Content="cancel" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="BuildClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="BuildStatusLabel" Text="redirected · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="1.1*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="BuildProblemsList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                   DisplayMemberPath="HeaderLine" FontFamily="Consolas" FontSize="11.5" Foreground="#DDD"/>
          <TextBox x:Name="BuildOutput" Grid.Column="2" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                   FontFamily="Consolas" FontSize="12"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdTestsHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="TestsRunBtn" Content="test" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="TestsCancelBtn" Content="cancel" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="TestsClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="TestsStatusLabel" Text="redirected · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="8"/>
            <RowDefinition Height="1.2*"/>
          </Grid.RowDefinitions>
          <ListBox x:Name="TestsFailList" Grid.Row="0" MaxHeight="140" Background="Transparent" BorderThickness="0"
                   DisplayMemberPath="Display" FontFamily="Consolas" FontSize="11.5" Foreground="#E8A0A0"/>
          <TextBox x:Name="TestsOutput" Grid.Row="3" IsReadOnly="True"
                   AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                   Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                   FontFamily="Consolas" FontSize="12"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdGitHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="GitStatusBtn" Content="refresh" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitStageBtn" Content="stage" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitUnstageBtn" Content="unstage" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitCommitBtn" Content="commit" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitPushBtn" Content="push" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitSubmoduleBtn" Content="submodule" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitCancelBtn" Content="cancel" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="GitClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="GitStatusLabel" Text="git · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
          <TextBlock DockPanel.Dock="Left" Text="msg" FontSize="11" Foreground="#888"
                     VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBox x:Name="GitCommitMessage" Height="26"
                   Background="#1A1A1A" Foreground="#DDD" BorderBrush="#3A3A3A"
                   FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="1.4*"/>
          </Grid.ColumnDefinitions>
          <ListBox x:Name="GitList" Grid.Column="0" Background="Transparent" BorderThickness="0"
                   FontFamily="Consolas" FontSize="12" Foreground="#DDD"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding Display}" FontFamily="Consolas" FontSize="12" Margin="0,1">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Foreground" Value="#B0B0B0"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Tone}" Value="change">
                          <Setter Property="Foreground" Value="#C8B87C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="add">
                          <Setter Property="Foreground" Value="#7CB87C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="delete">
                          <Setter Property="Foreground" Value="#C87C7C"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Tone}" Value="untracked">
                          <Setter Property="Foreground" Value="#7C9CB8"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <FlowDocumentScrollViewer x:Name="GitDiffViewer" Grid.Column="2"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsToolBarVisible="False"
                                    Background="Transparent" BorderThickness="0"/>
        </Grid>
      </DockPanel>
    </Border>
    <!-- Shared-SSOT quality: severity board (ERR/WARN/ALL) + jump list. -->
    <Border x:Name="MfdProblemsHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="ProblemsRefreshBtn" Content="refresh" Padding="8,2" Margin="0,0,6,0"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="ProblemsClearBtn" Content="clear" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="ProblemsStatusLabel" Text="problems · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <UniformGrid DockPanel.Dock="Top" Columns="3" Margin="0,0,0,8">
          <Border x:Name="ProblemsErrCard" Margin="0,0,6,0" Padding="10,8" CornerRadius="4"
                  Background="#2E1A1A" BorderBrush="#E05858" BorderThickness="1" Cursor="Hand">
            <StackPanel>
              <TextBlock Text="ERR" FontSize="10" Foreground="#888"/>
              <TextBlock x:Name="ProblemsErrCount" Text="0" FontSize="18" FontWeight="SemiBold"
                         FontFamily="Consolas" Foreground="#E0A8A8"/>
            </StackPanel>
          </Border>
          <Border x:Name="ProblemsWarnCard" Margin="0,0,6,0" Padding="10,8" CornerRadius="4"
                  Background="#2A2618" BorderBrush="#D7A33C" BorderThickness="1" Cursor="Hand">
            <StackPanel>
              <TextBlock Text="WARN" FontSize="10" Foreground="#888"/>
              <TextBlock x:Name="ProblemsWarnCount" Text="0" FontSize="18" FontWeight="SemiBold"
                         FontFamily="Consolas" Foreground="#E0C878"/>
            </StackPanel>
          </Border>
          <Border x:Name="ProblemsAllCard" Padding="10,8" CornerRadius="4"
                  Background="#1A1A1A" BorderBrush="#3A3A3A" BorderThickness="1" Cursor="Hand">
            <StackPanel>
              <TextBlock Text="ALL" FontSize="10" Foreground="#888"/>
              <TextBlock x:Name="ProblemsAllCount" Text="0" FontSize="18" FontWeight="SemiBold"
                         FontFamily="Consolas" Foreground="#DDD"/>
            </StackPanel>
          </Border>
        </UniformGrid>
        <ListBox x:Name="ProblemsList" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Margin="0,0,0,4" Padding="10,7,10,8" CornerRadius="5"
                      BorderThickness="1" BorderBrush="#22FFFFFF" Background="#12000000">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="4"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,10,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Background" Value="#D7A33C"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding IsError}" Value="True">
                            <Setter Property="Background" Value="#E05858"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                  </Border>
                  <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding HeaderLine}" FontFamily="Consolas" FontSize="11.5"
                               FontWeight="SemiBold" TextWrapping="Wrap" Foreground="#E8E8E8"/>
                    <TextBlock Text="{Binding Message}" FontSize="11" TextWrapping="Wrap"
                               Foreground="#AAAAAA" Margin="0,4,0,0"/>
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <!-- Shared-SSOT companions: list + Skia graph (not list-only dump). -->
    <Border x:Name="MfdRelatedFilesHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="RelatedRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="RelatedStatusLabel" Text="related · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#101010" BorderBrush="#2A2A2A" BorderThickness="1">
            <local:GlassSemanticMapSkia x:Name="RelatedSkia"/>
          </Border>
          <ListBox Grid.Column="2" x:Name="RelatedList" Background="Transparent" BorderThickness="0"
                   DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdHybridIndexHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="HybridIndexRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="HybridIndexStatusLabel" Text="hci · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <ItemsControl x:Name="HybridIndexCardsPanel" DockPanel.Dock="Top" Margin="0,0,0,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Columns="3"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#101010" BorderBrush="#2A2A2A" BorderThickness="1">
            <local:GlassSemanticMapSkia x:Name="HybridSkia"/>
          </Border>
          <ListBox Grid.Column="2" x:Name="HybridScopeList" Background="Transparent" BorderThickness="0"
                   FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdGlanceCardsHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="GlanceCardsRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="GlanceCardsStatusLabel" Text="glance · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <ItemsControl x:Name="GlanceCardsPanel">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel/>
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </ScrollViewer>
      </DockPanel>
    </Border>
    <Border x:Name="MfdSemanticMapHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="SemanticRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="SemanticStatusLabel" Text="semantic · skia graph"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Border Grid.Column="0" Background="#101010" BorderBrush="#2A2A2A" BorderThickness="1">
            <local:GlassSemanticMapSkia x:Name="SemanticSkia"/>
          </Border>
          <ListBox Grid.Column="2" x:Name="SemanticList" Background="Transparent" BorderThickness="0"
                   DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdCorrespondenceHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="CorrespondenceRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="CorrespondenceStatusLabel" Text="crs · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="reverse · code" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="CorrespondenceReverseList" Background="Transparent" BorderThickness="0"
                     DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="forward · docs" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="CorrespondenceForwardList" Background="Transparent" BorderThickness="0"
                     DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdMarkdownHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="MarkdownRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="MarkdownStatusLabel" Text="markdown · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <FlowDocumentScrollViewer x:Name="MarkdownDocumentViewer"
                                 VerticalScrollBarVisibility="Auto"
                                 IsToolBarVisible="False"
                                 Background="Transparent"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdDebugStackHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
            <Button x:Name="DebugContinueBtn" Content="▶" Padding="8,2" Margin="0,0,4,0" ToolTip="Continue (F5)"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="DebugStepIntoBtn" Content="↓" Padding="8,2" Margin="0,0,4,0" ToolTip="Step into"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="DebugStepOverBtn" Content="↷" Padding="8,2" Margin="0,0,4,0" ToolTip="Step over"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="DebugStepOutBtn" Content="↑" Padding="8,2" Margin="0,0,4,0" ToolTip="Step out"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
            <Button x:Name="DebugRefreshBtn" Content="refresh" Padding="8,2"
                    Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          </StackPanel>
          <TextBlock x:Name="DebugStatusLabel" Text="debug · spectator · no session"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <DockPanel Grid.Column="0">
            <TextBlock DockPanel.Dock="Top" Text="stack" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="DebugStackList" Background="Transparent" BorderThickness="0"
                     DisplayMemberPath="Display" FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
          <DockPanel Grid.Column="2">
            <TextBlock DockPanel.Dock="Top" Text="locals" FontSize="11" Foreground="#888" Margin="0,0,0,4"/>
            <ListBox x:Name="DebugLocalsList" Background="Transparent" BorderThickness="0"
                     FontFamily="Consolas" FontSize="12" Foreground="#DDD"/>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Border>
    <Border x:Name="MfdAiChatSettingsHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="AiChatSettingsRefreshBtn" DockPanel.Dock="Right" Content="refresh" Padding="8,2"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBlock x:Name="AiChatSettingsStatusLabel" Text="ai · settings.toml · idle"
                     FontSize="11" Foreground="#888" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>
        <TextBox x:Name="AiChatSettingsToml" IsReadOnly="True"
                 AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                 FontFamily="Consolas" FontSize="12"/>
      </DockPanel>
    </Border>
    <Border x:Name="MfdWebAiHost" Visibility="Collapsed" Background="#121212">
      <DockPanel Margin="8">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="WebAiGoBtn" DockPanel.Dock="Right" Content="go" Padding="8,2" Margin="8,0,0,0"
                  Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
          <TextBox x:Name="WebAiUrl" Padding="6,4"
                   Background="#1A1A1A" Foreground="#EEE" BorderBrush="#3A3A3A"
                   FontFamily="Consolas" FontSize="12"
                   Text="https://chatgpt.com"/>
        </DockPanel>
        <TextBlock x:Name="WebAiStatusLabel" DockPanel.Dock="Bottom" Margin="0,6,0,0"
                   Text="webai · WebView2 · idle"
                   FontSize="11" Foreground="#888" TextWrapping="Wrap"/>
        <wv2:WebView2 x:Name="WebAiView" DefaultBackgroundColor="#121212"/>
      </DockPanel>
    </Border>
  </Grid>
</UserControl>

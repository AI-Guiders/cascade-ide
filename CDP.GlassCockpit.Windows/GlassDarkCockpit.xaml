<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Flat chrome + Dark Cockpit (docs/design/flat-chrome-dark-cockpit-v1.md).
       Near-black night panel (G1000 night / EFI high-contrast cue) — not mid-gray charcoal.
       Quiet by default; electric accent only for selection / live instruments. -->
  <SolidColorBrush x:Key="Glass.Bg" Color="#0A0A0A"/>
  <SolidColorBrush x:Key="Glass.BgRaised" Color="#121212"/>
  <SolidColorBrush x:Key="Glass.BgPanel" Color="#141414"/>
  <SolidColorBrush x:Key="Glass.BgInset" Color="#0E0E0E"/>
  <SolidColorBrush x:Key="Glass.BgDeep" Color="#080808"/>
  <SolidColorBrush x:Key="Glass.Fg" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Glass.FgMuted" Color="#B0B0B0"/>
  <SolidColorBrush x:Key="Glass.FgDim" Color="#8A8A8A"/>
  <SolidColorBrush x:Key="Glass.FgTitle" Color="#D8D8D8"/>
  <SolidColorBrush x:Key="Glass.Border" Color="#2A3038"/>
  <SolidColorBrush x:Key="Glass.BorderSoft" Color="#22262C"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnBg" Color="#181818"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnFg" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnBorder" Color="#3A4048"/>
  <!-- Selection / focus — electric cool cyan (G1000 night cue), not purple. -->
  <SolidColorBrush x:Key="Glass.SelectBg" Color="#152028"/>
  <SolidColorBrush x:Key="Glass.SelectBorder" Color="#4A8AB0"/>
  <SolidColorBrush x:Key="Glass.SelectFg" Color="#F0F0F0"/>
  <SolidColorBrush x:Key="Glass.Electric" Color="#5BB8D8"/>
  <SolidColorBrush x:Key="Glass.ElectricDim" Color="#3A7A94"/>
  <SolidColorBrush x:Key="Glass.ElectricRail" Color="#244858"/>
  <!-- Indication chips — Quiet / Caution / Warn / Fail -->
  <SolidColorBrush x:Key="Glass.ChipQuietBg" Color="#101418"/>
  <SolidColorBrush x:Key="Glass.ChipQuietBorder" Color="#2A323A"/>
  <SolidColorBrush x:Key="Glass.ChipQuietFg" Color="#A0AAB4"/>
  <SolidColorBrush x:Key="Glass.CautionBg" Color="#221C10"/>
  <SolidColorBrush x:Key="Glass.CautionBorder" Color="#6A5A30"/>
  <SolidColorBrush x:Key="Glass.CautionFg" Color="#D0B870"/>
  <SolidColorBrush x:Key="Glass.WarnBg" Color="#241810"/>
  <SolidColorBrush x:Key="Glass.WarnBorder" Color="#A07830"/>
  <SolidColorBrush x:Key="Glass.WarnFg" Color="#E6B85A"/>
  <SolidColorBrush x:Key="Glass.FailBg" Color="#221010"/>
  <SolidColorBrush x:Key="Glass.FailBorder" Color="#8A4040"/>
  <SolidColorBrush x:Key="Glass.FailFg" Color="#E07070"/>
  <SolidColorBrush x:Key="Glass.OverlayScrim" Color="#CC000000"/>
  <SolidColorBrush x:Key="Glass.BubbleBg" Color="#121212"/>
  <SolidColorBrush x:Key="Glass.BubbleBorder" Color="#2A3038"/>
  <SolidColorBrush x:Key="Glass.BubbleMeta" Color="#9AA0A6"/>
  <!-- ECAM / section surfaces (UiKit adapt) -->
  <SolidColorBrush x:Key="Glass.EcamBg" Color="#0E1216"/>
  <SolidColorBrush x:Key="Glass.EcamBorder" Color="#242C34"/>
  <SolidColorBrush x:Key="Glass.EcamLabel" Color="#7A8490"/>
  <SolidColorBrush x:Key="Glass.EcamValue" Color="#D8DEE4"/>
  <SolidColorBrush x:Key="Glass.EcamSub" Color="#6A9AB0"/>
  <!-- SoftKey / DeckCard (WPF UiKit edit-locus — modern Glass, not Avalonia ECAM green) -->
  <SolidColorBrush x:Key="Glass.SoftKeyBg" Color="#14181C"/>
  <SolidColorBrush x:Key="Glass.SoftKeyBgHover" Color="#1A242C"/>
  <SolidColorBrush x:Key="Glass.SoftKeyBgPressed" Color="#152028"/>
  <SolidColorBrush x:Key="Glass.SoftKeyBorder" Color="#3A4A58"/>
  <SolidColorBrush x:Key="Glass.SoftKeyFg" Color="#C8D4DC"/>
  <SolidColorBrush x:Key="Glass.DeckOkBg" Color="#121A16"/>
  <SolidColorBrush x:Key="Glass.DeckOkBorder" Color="#3A6A4A"/>
  <SolidColorBrush x:Key="Glass.DeckOkFg" Color="#A8D8B0"/>
  <SolidColorBrush x:Key="Glass.DeckWarnBg" Color="#1A1810"/>
  <SolidColorBrush x:Key="Glass.DeckWarnBorder" Color="#8A7030"/>
  <SolidColorBrush x:Key="Glass.DeckWarnFg" Color="#E0C878"/>
  <SolidColorBrush x:Key="Glass.DeckBadBg" Color="#1A1212"/>
  <SolidColorBrush x:Key="Glass.DeckBadBorder" Color="#8A4040"/>
  <SolidColorBrush x:Key="Glass.DeckBadFg" Color="#E0A8A8"/>
  <SolidColorBrush x:Key="Glass.DeckIdleBg" Color="#101418"/>
  <SolidColorBrush x:Key="Glass.DeckIdleBorder" Color="#2A323A"/>
  <SolidColorBrush x:Key="Glass.DeckIdleFg" Color="#888888"/>
  <SolidColorBrush x:Key="Glass.DeckMetaBg" Color="#101418"/>
  <SolidColorBrush x:Key="Glass.DeckMetaBorder" Color="#2A4050"/>
  <SolidColorBrush x:Key="Glass.DeckMetaFg" Color="#7A9AB0"/>
</ResourceDictionary>

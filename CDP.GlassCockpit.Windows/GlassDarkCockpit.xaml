<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Flat chrome + Dark Cockpit (docs/design/flat-chrome-dark-cockpit-v1.md).
       Quiet by default: one muted accent for selection; no per-zone rainbow. -->
  <SolidColorBrush x:Key="Glass.Bg" Color="#111111"/>
  <SolidColorBrush x:Key="Glass.BgRaised" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="Glass.BgPanel" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Glass.BgInset" Color="#161616"/>
  <SolidColorBrush x:Key="Glass.BgDeep" Color="#121212"/>
  <SolidColorBrush x:Key="Glass.Fg" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="Glass.FgMuted" Color="#AAAAAA"/>
  <SolidColorBrush x:Key="Glass.FgDim" Color="#888888"/>
  <SolidColorBrush x:Key="Glass.FgTitle" Color="#C8C8C8"/>
  <SolidColorBrush x:Key="Glass.Border" Color="#333841"/>
  <SolidColorBrush x:Key="Glass.BorderSoft" Color="#2E2E2E"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnBg" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnFg" Color="#DDDDDD"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnBorder" Color="#3F3F46"/>
  <!-- Selection / focus only (not per-seat identity paint). -->
  <SolidColorBrush x:Key="Glass.SelectBg" Color="#2A3038"/>
  <SolidColorBrush x:Key="Glass.SelectBorder" Color="#5A6570"/>
  <SolidColorBrush x:Key="Glass.SelectFg" Color="#E8E8E8"/>
  <!-- Caution: only for real status chips (ON GND / W-C). -->
  <SolidColorBrush x:Key="Glass.CautionBg" Color="#2A2418"/>
  <SolidColorBrush x:Key="Glass.CautionBorder" Color="#6A5A30"/>
  <SolidColorBrush x:Key="Glass.CautionFg" Color="#C8B070"/>
  <SolidColorBrush x:Key="Glass.OverlayScrim" Color="#AA000000"/>
  <SolidColorBrush x:Key="Glass.BubbleBg" Color="#1C1C1C"/>
  <SolidColorBrush x:Key="Glass.BubbleBorder" Color="#333841"/>
  <SolidColorBrush x:Key="Glass.BubbleMeta" Color="#9A9A9A"/>
</ResourceDictionary>

<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Flat chrome + Dark Cockpit (docs/design/flat-chrome-dark-cockpit-v1.md).
       Quiet by default; electric accent only for selection / live instruments.
       Adapted from Avalonia UiKit semantics — WPF electric Glass, not AXAML copy. -->
  <SolidColorBrush x:Key="Glass.Bg" Color="#111111"/>
  <SolidColorBrush x:Key="Glass.BgRaised" Color="#1A1A1A"/>
  <SolidColorBrush x:Key="Glass.BgPanel" Color="#1E1E1E"/>
  <SolidColorBrush x:Key="Glass.BgInset" Color="#161616"/>
  <SolidColorBrush x:Key="Glass.BgDeep" Color="#121212"/>
  <SolidColorBrush x:Key="Glass.Fg" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="Glass.FgMuted" Color="#AAAAAA"/>
  <SolidColorBrush x:Key="Glass.FgDim" Color="#888888"/>
  <SolidColorBrush x:Key="Glass.FgTitle" Color="#C8C8C8"/>
  <SolidColorBrush x:Key="Glass.Border" Color="#333841"/>
  <SolidColorBrush x:Key="Glass.BorderSoft" Color="#2E2E2E"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnBg" Color="#2A2A2A"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnFg" Color="#DDDDDD"/>
  <SolidColorBrush x:Key="Glass.ChromeBtnBorder" Color="#3F3F46"/>
  <!-- Selection / focus — electric cool, not purple. -->
  <SolidColorBrush x:Key="Glass.SelectBg" Color="#1C2834"/>
  <SolidColorBrush x:Key="Glass.SelectBorder" Color="#4A7A9A"/>
  <SolidColorBrush x:Key="Glass.SelectFg" Color="#E8E8E8"/>
  <SolidColorBrush x:Key="Glass.Electric" Color="#5BA3C9"/>
  <SolidColorBrush x:Key="Glass.ElectricDim" Color="#3A6A84"/>
  <SolidColorBrush x:Key="Glass.ElectricRail" Color="#2A4A5C"/>
  <!-- Indication chips — Quiet / Caution / Warn / Fail -->
  <SolidColorBrush x:Key="Glass.ChipQuietBg" Color="#181B20"/>
  <SolidColorBrush x:Key="Glass.ChipQuietBorder" Color="#2E343C"/>
  <SolidColorBrush x:Key="Glass.ChipQuietFg" Color="#9AA3AD"/>
  <SolidColorBrush x:Key="Glass.CautionBg" Color="#2A2418"/>
  <SolidColorBrush x:Key="Glass.CautionBorder" Color="#6A5A30"/>
  <SolidColorBrush x:Key="Glass.CautionFg" Color="#C8B070"/>
  <SolidColorBrush x:Key="Glass.WarnBg" Color="#2C2214"/>
  <SolidColorBrush x:Key="Glass.WarnBorder" Color="#A07830"/>
  <SolidColorBrush x:Key="Glass.WarnFg" Color="#E6B85A"/>
  <SolidColorBrush x:Key="Glass.FailBg" Color="#2A1818"/>
  <SolidColorBrush x:Key="Glass.FailBorder" Color="#8A4040"/>
  <SolidColorBrush x:Key="Glass.FailFg" Color="#E07070"/>
  <SolidColorBrush x:Key="Glass.OverlayScrim" Color="#AA000000"/>
  <SolidColorBrush x:Key="Glass.BubbleBg" Color="#1C1C1C"/>
  <SolidColorBrush x:Key="Glass.BubbleBorder" Color="#333841"/>
  <SolidColorBrush x:Key="Glass.BubbleMeta" Color="#9A9A9A"/>
  <!-- ECAM / section surfaces (UiKit adapt) -->
  <SolidColorBrush x:Key="Glass.EcamBg" Color="#171A1E"/>
  <SolidColorBrush x:Key="Glass.EcamBorder" Color="#2A313A"/>
  <SolidColorBrush x:Key="Glass.EcamLabel" Color="#7A8490"/>
  <SolidColorBrush x:Key="Glass.EcamValue" Color="#D0D6DC"/>
  <SolidColorBrush x:Key="Glass.EcamSub" Color="#6A9AB0"/>
</ResourceDictionary>

<Window x:Class="CDP.GlassCockpit.Windows.ZoneHostWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Glass zone host"
        Height="720" Width="960"
        WindowStartupLocation="Manual"
        Background="#111111"
        Foreground="#E8E8E8">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="10,6">
      <TextBlock x:Name="HostBadge" Text="host" FontFamily="Consolas" FontSize="11" Foreground="#8FD4A8"/>
    </Border>
    <ContentControl x:Name="HostSlot"/>
  </DockPanel>
</Window>

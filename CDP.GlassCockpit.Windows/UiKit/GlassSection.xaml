<ContentControl x:Class="CDP.GlassCockpit.Windows.UiKit.GlassSection"
                xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ContentControl.Template>
    <ControlTemplate TargetType="ContentControl">
      <!-- CascadeSection adapt — flat glass inset with electric rail. -->
      <Border Background="{StaticResource Glass.BgInset}"
              BorderBrush="{StaticResource Glass.BorderSoft}"
              BorderThickness="1"
              CornerRadius="4">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="2" Background="{StaticResource Glass.ElectricRail}"
                  CornerRadius="4,0,0,4" Margin="0,4,0,4"/>
          <ContentPresenter Margin="8,6"/>
        </DockPanel>
      </Border>
    </ControlTemplate>
  </ContentControl.Template>
</ContentControl>

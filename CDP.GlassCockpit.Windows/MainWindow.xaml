<Window x:Class="CDP.GlassCockpit.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="CDP GlassCockpit · Windows"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="#111111"
        Foreground="#E8E8E8">
  <Window.Resources>
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="BorderBrush" Value="#3F3F46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Top chrome (CIDE-like band) -->
    <Border DockPanel.Dock="Top" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Background="#5A1A1A" BorderBrush="#C88A2A" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
          <TextBlock Text="ON GND" Foreground="#FFD27A" FontWeight="SemiBold" FontSize="11"/>
        </Border>
        <Border Grid.Column="1" Background="#1A2A22" BorderBrush="#2A5A40" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="0,0,8,0">
          <TextBlock x:Name="TopologyBadge" Text="(F)" Foreground="#8FD4A8" FontFamily="Consolas" FontSize="11"/>
        </Border>
        <Border Grid.Column="2" Background="#1E2A3A" BorderBrush="#2F4A6A" BorderThickness="1" CornerRadius="4" Padding="10,5">
          <StackPanel>
            <TextBlock x:Name="ChromeHint" Text="settings.toml · loading…" Foreground="#9BB6D4" FontSize="12"/>
            <TextBlock x:Name="SoftOrganHint" Text="" Foreground="#C9B896" FontSize="11" Margin="0,2,0,0"
                       Visibility="Collapsed" TextWrapping="Wrap"/>
          </StackPanel>
        </Border>
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="#888" FontSize="11"
                   Text="GlassCockpit.Windows · GlassCore"/>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#1A1A1A" Foreground="#AAAAAA">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="glass · idle"/>
      </StatusBarItem>
    </StatusBar>

    <!-- P | F | M — widths from GlassCore PresentationMainGridLayoutFrameBuilder -->
    <Grid x:Name="MainGrid" Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- P -->
      <Border x:Name="PfdZone" Grid.Column="0" BorderBrush="#003D4A" BorderThickness="1" Background="#161616" Margin="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock Text="P · PFD" FontWeight="SemiBold" FontSize="12" Foreground="#7FD4E0"/>
          </Border>
          <StackPanel Margin="10">
            <TextBlock Text="Solution / map" FontSize="11" Foreground="#888" Margin="0,0,0,8"/>
            <TextBlock x:Name="PlanTitle" Text="(no solution yet)" FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,12"/>
            <TextBlock x:Name="PlanMeta" FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#222"/>

      <!-- F Intercom / Editor (primary_work_surface) -->
      <Border Grid.Column="2" BorderBrush="#4A3A10" BorderThickness="1" Background="#141414" Margin="0,4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="12,8" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock x:Name="ForwardTitle" DockPanel.Dock="Left" Text="F · Intercom" FontWeight="SemiBold" FontSize="12" Foreground="#FFC75A" VerticalAlignment="Center"/>
              <TextBlock x:Name="IntercomSubtitle" HorizontalAlignment="Right" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <!-- ADR 0120: editor XOR intercom on Forward; when Forward=intercom, editor mounts on M -->
          <Grid x:Name="ForwardBody">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="ForwardEditorRow" Height="2*"/>
              <RowDefinition x:Name="ForwardSplitRow" Height="4"/>
              <RowDefinition x:Name="ForwardIntercomRow" Height="*" MinHeight="180"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="ForwardEditorHost" Grid.Row="0">
              <Border x:Name="EditorChrome" Background="#121212">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="10,4" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <Button x:Name="SaveFileBtn" DockPanel.Dock="Right" Content="Save" Style="{StaticResource ChromeBtn}"
                              Click="SaveFileBtn_OnClick" ToolTip="Save (Ctrl+S)" Margin="8,0,0,0"/>
                      <Button x:Name="OpenFileBtn" DockPanel.Dock="Right" Content="Open…" Style="{StaticResource ChromeBtn}"
                              Click="OpenFileBtn_OnClick" ToolTip="Open a file (Ctrl+O)" Margin="8,0,0,0"/>
                      <TextBlock x:Name="EditorPathLabel" Text="(no file)" FontSize="11" Foreground="#9BB6D4"
                                 FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <avalonEdit:TextEditor x:Name="CodeEditor"
                                         FontFamily="Consolas"
                                         FontSize="13"
                                         Background="#1E1E1E"
                                         Foreground="#D4D4D4"
                                         LineNumbersForeground="#858585"
                                         ShowLineNumbers="True"
                                         WordWrap="False"
                                         IsReadOnly="False"/>
                </DockPanel>
              </Border>
            </ContentControl>

            <GridSplitter x:Name="ForwardSplit" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#222"/>

            <DockPanel x:Name="IntercomSurface" Grid.Row="2">
              <Border DockPanel.Dock="Bottom" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="10">
                <DockPanel>
                  <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send" Style="{StaticResource ChromeBtn}"
                          Click="SendBtn_OnClick" ToolTip="Send to @PF (Enter / Ctrl+Enter; Shift+Enter = newline)"/>
                  <TextBox x:Name="ComposerBox"
                           AcceptsReturn="True"
                           TextWrapping="Wrap"
                           MinHeight="40" MaxHeight="120"
                           VerticalScrollBarVisibility="Auto"
                           Background="#222"
                           Foreground="#EEE"
                           BorderBrush="#3F3F46"
                           BorderThickness="1"
                           Padding="8"
                           FontFamily="Segoe UI"
                           FontSize="13"
                           Margin="0,0,8,0"
                           Text="Message @PF…"
                           PreviewKeyDown="ComposerBox_OnPreviewKeyDown"
                           GotKeyboardFocus="ComposerBox_OnGotKeyboardFocus"/>
                </DockPanel>
              </Border>

              <Border DockPanel.Dock="Top" Background="#151820" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Topics" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button x:Name="TopicAllBtn" DockPanel.Dock="Left" Content="All" Style="{StaticResource ChromeBtn}"
                          Click="TopicAllBtn_OnClick" ToolTip="Show full Virtual History feed" Margin="0,0,6,0"/>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TopicCards">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Title}" Style="{StaticResource ChromeBtn}"
                                  Margin="0,0,6,0" MaxWidth="280"
                                  ToolTip="{Binding Title}"
                                  Tag="{Binding Id}"
                                  Click="TopicCard_OnClick"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Padding="10">
                <ItemsControl x:Name="MessageFeed">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                              Background="#1C2430" BorderBrush="#2F3F55" BorderThickness="1"
                              HorizontalAlignment="Stretch">
                        <StackPanel>
                          <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Foreground="#7EB6FF"/>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="10" Foreground="#666" HorizontalAlignment="Right"/>
                          </DockPanel>
                          <TextBlock Text="{Binding Body}" FontSize="13" TextWrapping="Wrap" Foreground="#E8E8E8" LineHeight="18"/>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#222"/>

      <!-- M MFD shell -->
      <Border x:Name="MfdZone" Grid.Column="4" BorderBrush="#3A2A55" BorderThickness="1" Background="#161616" Margin="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock Text="M · MFD" FontWeight="SemiBold" FontSize="12" Foreground="#B38CFF"/>
          </Border>
          <Border DockPanel.Dock="Top" Background="#1A1520" Padding="8,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock x:Name="MfdHealth" Text="EICAS · idle" FontSize="11" Foreground="#9A8AB8"/>
          </Border>
          <ListBox x:Name="MfdPages"
                   DockPanel.Dock="Left"
                   Width="130"
                   Background="#141414"
                   Foreground="#DDD"
                   BorderThickness="0"
                   FontFamily="Segoe UI"
                   FontSize="12"
                   SelectionChanged="MfdPages_OnSelectionChanged">
            <ListBoxItem Content="SolutionExplorer"/>
            <ListBoxItem Content="Terminal" IsSelected="True"/>
            <ListBoxItem Content="Build"/>
            <ListBoxItem Content="Problems"/>
            <ListBoxItem Content="Git"/>
            <ListBoxItem Content="DebugStack"/>
            <ListBoxItem Content="SemanticMap"/>
            <ListBoxItem Content="Chat"/>
            <ListBoxItem Content="Editor"/>
          </ListBox>
          <Grid>
            <TextBlock x:Name="MfdBody" TextWrapping="Wrap" FontSize="13" Foreground="#CCCCCC"
                       Margin="12" Text="Select an MFD page."/>
            <ContentControl x:Name="MfdEditorHost" Visibility="Collapsed"/>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>
</Window>

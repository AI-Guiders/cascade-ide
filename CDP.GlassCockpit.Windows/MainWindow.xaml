<Window x:Class="CDP.GlassCockpit.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:uikit="clr-namespace:CDP.GlassCockpit.Windows.UiKit"
        Title="CDP GlassCockpit · Windows"
        Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Glass.Bg}"
        Foreground="{StaticResource Glass.Fg}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GlassDarkCockpit.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    <Style x:Key="ChromeBtn" TargetType="Button">
      <Setter Property="Background" Value="#2A2A2A"/>
      <Setter Property="Foreground" Value="#DDDDDD"/>
      <Setter Property="BorderBrush" Value="#3F3F46"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,4"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
    <Style x:Key="TopicCardBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
      <Style.Triggers>
        <DataTrigger Binding="{Binding IsSelected}" Value="True">
          <Setter Property="Background" Value="{StaticResource Glass.SelectBg}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Glass.SelectBorder}"/>
          <Setter Property="Foreground" Value="{StaticResource Glass.SelectFg}"/>
        </DataTrigger>
      </Style.Triggers>
    </Style>
    <Style x:Key="TopicAllBtnStyle" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
      <Style.Triggers>
        <Trigger Property="Tag" Value="selected">
          <Setter Property="Background" Value="{StaticResource Glass.SelectBg}"/>
          <Setter Property="BorderBrush" Value="{StaticResource Glass.SelectBorder}"/>
          <Setter Property="Foreground" Value="{StaticResource Glass.SelectFg}"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
  <DockPanel>
    <!-- Top chrome (CIDE-like band) -->
    <Border DockPanel.Dock="Top" Background="#1A1A1A" BorderBrush="#2E2E2E" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <uikit:GlassStatusChip Text="ON GND" Level="Caution" Margin="0,0,6,0"/>
        <uikit:GlassStatusChip x:Name="TopologyBadge" Grid.Column="1" Text="(F)" Level="Quiet" Margin="0,0,6,0"/>
        <!-- Indication strip: GlassStatusChip band (UiKit adapt). Full SoftOrgan text in Tip. -->
        <Border Grid.Column="2" Background="{StaticResource Glass.BgPanel}" BorderBrush="{StaticResource Glass.Border}"
                BorderThickness="1" CornerRadius="4" Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Left" Width="2" Background="{StaticResource Glass.ElectricRail}"
                    CornerRadius="4,0,0,4" Margin="0,3,0,3"/>
            <DockPanel Margin="8,4">
              <uikit:GlassStatusChip x:Name="ChromeHintChip" DockPanel.Dock="Left" Text="CFG" Level="Quiet"
                                    Tip="settings.toml · loading…" Margin="0,0,6,0"/>
              <StackPanel x:Name="SoftOrganBand" Orientation="Horizontal" Visibility="Collapsed">
                <ItemsControl x:Name="SoftOrganChips">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <uikit:GlassStatusChip Text="{Binding Label}" Tip="{Binding Tip}" Level="{Binding Level}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="SoftOrganOverflowHost" Visibility="Collapsed"
                        Background="{StaticResource Glass.ChipQuietBg}"
                        BorderBrush="{StaticResource Glass.ChipQuietBorder}" BorderThickness="1" CornerRadius="3"
                        Padding="7,2" Cursor="Hand" MouseLeftButtonUp="SoftOrganOverflow_OnClick">
                  <TextBlock x:Name="SoftOrganOverflow" Text="" Foreground="{StaticResource Glass.ChipQuietFg}"
                             FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"/>
                </Border>
              </StackPanel>
            </DockPanel>
          </DockPanel>
        </Border>
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0"
                   Foreground="{StaticResource Glass.ElectricDim}" FontSize="10" FontFamily="Consolas" Text="GLASS"/>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="#1A1A1A" Foreground="#AAAAAA">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="glass · idle"/>
      </StatusBarItem>
    </StatusBar>

    <!-- P | F | M — widths from GlassCore PresentationMainGridLayoutFrameBuilder -->
    <Grid x:Name="MainGrid" Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- P · one page (no nav list) — glance fills the instrument -->
      <Border x:Name="PfdZone" Grid.Column="0" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1" Background="#161616" Margin="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock x:Name="PfdZoneTitle" Text="P · Plan" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Glass.FgTitle}"/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
            <StackPanel>
              <uikit:GlassEcamReadout x:Name="PlanReadout" Label="PLAN" ValueText="(no solution yet)"/>
              <!-- Keep PlanTitle/PlanMeta for latch paint; mirrored into PlanReadout. -->
              <TextBlock x:Name="PlanTitle" Visibility="Collapsed" Text="(no solution yet)"/>
              <TextBlock x:Name="PlanMeta" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#222"/>

      <!-- F Intercom / Editor (primary_work_surface) -->
      <Border Grid.Column="2" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1" Background="#141414" Margin="0,4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="12,8" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock x:Name="ForwardTitle" DockPanel.Dock="Left" Text="F · Intercom" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Glass.FgTitle}" VerticalAlignment="Center"/>
              <TextBlock x:Name="IntercomSubtitle" HorizontalAlignment="Right" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <!-- ADR 0120: editor XOR intercom on Forward; when Forward=intercom, editor mounts on M -->
          <Grid x:Name="ForwardBody">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="ForwardEditorRow" Height="2*"/>
              <RowDefinition x:Name="ForwardSplitRow" Height="4"/>
              <RowDefinition x:Name="ForwardIntercomRow" Height="*" MinHeight="180"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="ForwardEditorHost" Grid.Row="0">
              <Border x:Name="EditorChrome" Background="#0D1117">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="10,4" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <Button x:Name="SaveFileBtn" DockPanel.Dock="Right" Content="Save" Style="{StaticResource ChromeBtn}"
                              Click="SaveFileBtn_OnClick" ToolTip="Save (Ctrl+S)" Margin="8,0,0,0"/>
                      <Button x:Name="OpenFileBtn" DockPanel.Dock="Right" Content="Open…" Style="{StaticResource ChromeBtn}"
                              Click="OpenFileBtn_OnClick" ToolTip="Open a file (Ctrl+O)" Margin="8,0,0,0"/>
                      <TextBlock x:Name="EditorPathLabel" Text="(no file)" FontSize="11" Foreground="{StaticResource Glass.FgMuted}"
                                 FontFamily="Consolas" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    </DockPanel>
                  </Border>
                  <avalonEdit:TextEditor x:Name="CodeEditor"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         FontSize="14.5"
                                         Background="#0D1117"
                                         Foreground="#E6EDF3"
                                         LineNumbersForeground="#6E7681"
                                         ShowLineNumbers="True"
                                         WordWrap="False"
                                         IsReadOnly="False"/>
                </DockPanel>
              </Border>
            </ContentControl>

            <GridSplitter x:Name="ForwardSplit" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#222"/>

            <DockPanel x:Name="IntercomSurface" Grid.Row="2">
              <Border DockPanel.Dock="Bottom" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="10">
                <Grid>
                  <Popup x:Name="SlashPopup"
                         Placement="Top"
                         PlacementTarget="{Binding ElementName=ComposerBox}"
                         StaysOpen="False"
                         AllowsTransparency="True">
                    <Border Background="{StaticResource Glass.BgPanel}" BorderBrush="#3F3F46" BorderThickness="1" Padding="4" MaxHeight="220" MinWidth="280">
                      <ListBox x:Name="SlashList"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="#EEE"
                               FontFamily="Consolas"
                               FontSize="12">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="2,2">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Help}" Foreground="{StaticResource Glass.FgMuted}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Border>
                  </Popup>
                  <DockPanel>
                    <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send" Style="{StaticResource ChromeBtn}"
                            Click="SendBtn_OnClick" ToolTip="Send to @PF (Enter / Ctrl+Enter; Shift+Enter = newline; / = slash)"/>
                    <TextBox x:Name="ComposerBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="40" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             Background="#222"
                             Foreground="#EEE"
                             BorderBrush="#3F3F46"
                             BorderThickness="1"
                             Padding="8"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Margin="0,0,8,0"
                             Text="Message @PF…"
                             PreviewKeyDown="ComposerBox_OnPreviewKeyDown"
                             GotKeyboardFocus="ComposerBox_OnGotKeyboardFocus"/>
                  </DockPanel>
                </Grid>
              </Border>

              <Border DockPanel.Dock="Top" Background="{StaticResource Glass.BgRaised}" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                  <TextBlock DockPanel.Dock="Left" Text="Topics" FontSize="11" Foreground="#888" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <Button x:Name="TopicAllBtn" DockPanel.Dock="Left" Content="All" Style="{StaticResource TopicAllBtnStyle}"
                          Click="TopicAllBtn_OnClick" ToolTip="Show full Virtual History feed" Margin="0,0,6,0" Tag="selected"/>
                  <TextBlock x:Name="TopicsEmptyHint" DockPanel.Dock="Left"
                             Text="(empty — send a few messages; cards cluster by 30m gap)"
                             FontSize="11" Foreground="#555" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
                  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TopicCards">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Content="{Binding Title}" Style="{StaticResource TopicCardBtn}"
                                  Margin="0,0,6,0" MaxWidth="280"
                                  ToolTip="{Binding Title}"
                                  Tag="{Binding Id}"
                                  Click="TopicCard_OnClick"/>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>

              <Grid>
                <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Padding="10"
                              ScrollChanged="FeedScroll_OnScrollChanged">
                  <ItemsControl x:Name="MessageFeed">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="10,8" CornerRadius="6"
                                Background="{StaticResource Glass.BubbleBg}" BorderBrush="{StaticResource Glass.BubbleBorder}" BorderThickness="1"
                                HorizontalAlignment="Stretch">
                          <StackPanel>
                            <DockPanel Margin="0,0,0,4">
                              <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Glass.BubbleMeta}"/>
                              <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="10" Foreground="#666" HorizontalAlignment="Right"/>
                            </DockPanel>
                            <TextBlock Text="{Binding Body}" FontSize="13" TextWrapping="Wrap" Foreground="#E8E8E8" LineHeight="18"/>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button x:Name="NewMsgCueBtn"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Style="{StaticResource ChromeBtn}"
                        Background="{StaticResource Glass.SelectBg}" BorderBrush="{StaticResource Glass.SelectBorder}" Foreground="{StaticResource Glass.SelectFg}"
                        Visibility="Collapsed"
                        Click="NewMsgCueBtn_OnClick"
                        ToolTip="Jump to latest messages"/>
              </Grid>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#222"/>

      <!-- M · one page fills instrument; page select via seats/palette (not mouse list) -->
      <Border x:Name="MfdZone" Grid.Column="4" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1" Background="#161616" Margin="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock x:Name="MfdZoneTitle" Text="M · Terminal" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Glass.FgTitle}"/>
          </Border>
          <Border DockPanel.Dock="Top" Background="{StaticResource Glass.BgRaised}" Padding="8,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock x:Name="MfdHealth" Text="EICAS · idle" FontSize="11" Foreground="{StaticResource Glass.FgMuted}"/>
          </Border>
          <!-- Catalog kept for SelectMfdPage / seats latch; not shown (aviation: one page on glass). -->
          <ListBox x:Name="MfdPages"
                   Visibility="Collapsed"
                   Width="0" Height="0"
                   SelectionChanged="MfdPages_OnSelectionChanged">
            <ListBoxItem Content="SolutionExplorer"/>
            <ListBoxItem Content="Terminal" IsSelected="True"/>
            <ListBoxItem Content="Build"/>
            <ListBoxItem Content="Tests"/>
            <ListBoxItem Content="Problems"/>
            <ListBoxItem Content="Git"/>
            <ListBoxItem Content="DebugStack"/>
            <ListBoxItem Content="SemanticMap"/>
            <ListBoxItem Content="HybridIndex"/>
            <ListBoxItem Content="RelatedFiles"/>
            <ListBoxItem Content="Correspondence"/>
            <ListBoxItem Content="MarkdownPreview"/>
            <ListBoxItem Content="WebAiPortal"/>
            <ListBoxItem Content="AiChatSettings"/>
            <ListBoxItem Content="WorkspaceHealth"/>
            <ListBoxItem Content="EnvironmentReadiness"/>
            <ListBoxItem Content="Events"/>
            <ListBoxItem Content="Hypotheses"/>
            <ListBoxItem Content="Chat"/>
            <ListBoxItem Content="Editor"/>
          </ListBox>
          <Grid>
            <TextBlock x:Name="MfdBody" TextWrapping="Wrap" FontSize="13" Foreground="#CCCCCC"
                       Margin="12" Text="Select an MFD page."/>
            <TreeView x:Name="MfdSolutionExplorerTree" Visibility="Collapsed"
                      Margin="8" FontSize="13" Background="Transparent" BorderThickness="0"
                      Foreground="#CCCCCC"
                      MouseDoubleClick="MfdSolutionExplorerTree_OnMouseDoubleClick"/>
            <ContentControl x:Name="MfdEditorHost" Visibility="Collapsed"/>
            <Border x:Name="MfdTerminalHost" Visibility="Collapsed" Background="#121212">
              <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <Button DockPanel.Dock="Right" Content="restart" Padding="8,2" Margin="8,0,0,0"
                          Click="TerminalRestart_OnClick"
                          Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                  <TextBlock x:Name="TerminalShellLabel" Text="redirected · idle"
                             FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="TerminalInput" DockPanel.Dock="Bottom"
                         Margin="0,6,0,0" Padding="6,4"
                         Background="#1A1A1A" Foreground="#EEE" BorderBrush="#3A3A3A"
                         FontFamily="Consolas" FontSize="12"
                         KeyDown="TerminalInput_OnKeyDown"/>
                <TextBox x:Name="TerminalOutput" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"/>
              </DockPanel>
            </Border>
            <Border x:Name="MfdBuildHost" Visibility="Collapsed" Background="#121212">
              <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="build" Padding="8,2" Margin="0,0,6,0"
                            Click="BuildRun_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                    <Button Content="cancel" Padding="8,2" Margin="0,0,6,0"
                            Click="BuildCancel_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                    <Button Content="clear" Padding="8,2"
                            Click="BuildClear_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                  </StackPanel>
                  <TextBlock x:Name="BuildStatusLabel" Text="redirected · idle"
                             FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="BuildOutput" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"/>
              </DockPanel>
            </Border>
            <Border x:Name="MfdTestsHost" Visibility="Collapsed" Background="#121212">
              <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="test" Padding="8,2" Margin="0,0,6,0"
                            Click="TestsRun_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                    <Button Content="cancel" Padding="8,2" Margin="0,0,6,0"
                            Click="TestsCancel_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                    <Button Content="clear" Padding="8,2"
                            Click="TestsClear_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                  </StackPanel>
                  <TextBlock x:Name="TestsStatusLabel" Text="redirected · idle"
                             FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="TestsOutput" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"/>
              </DockPanel>
            </Border>
            <Border x:Name="MfdGitHost" Visibility="Collapsed" Background="#121212">
              <DockPanel Margin="8">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="status" Padding="8,2" Margin="0,0,6,0"
                            Click="GitStatus_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                    <Button Content="cancel" Padding="8,2" Margin="0,0,6,0"
                            Click="GitCancel_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                    <Button Content="clear" Padding="8,2"
                            Click="GitClear_OnClick"
                            Background="#2A2A2A" Foreground="#CCC" BorderBrush="#3A3A3A"/>
                  </StackPanel>
                  <TextBlock x:Name="GitStatusLabel" Text="redirected · idle"
                             FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="GitOutput" IsReadOnly="True"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         Background="Transparent" Foreground="#CCCCCC" BorderThickness="0"
                         FontFamily="Consolas" FontSize="12"/>
              </DockPanel>
            </Border>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>

    <Border x:Name="PaletteOverlay"
            Visibility="Collapsed"
            Background="{StaticResource Glass.OverlayScrim}"
            Panel.ZIndex="100">
      <Border Width="520" MaxHeight="420"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource Glass.BgRaised}" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1"
              Padding="12" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Command palette" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Bottom" Text="Ctrl+Q toggle · Esc close · Enter run"
                     Foreground="{StaticResource Glass.FgMuted}" FontSize="11" Margin="0,8,0,0"/>
          <TextBox x:Name="PaletteQuery"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Background="#222" Foreground="#EEE" BorderBrush="#3F3F46"
                   Padding="8" FontFamily="Segoe UI" FontSize="13"/>
          <ListBox x:Name="PaletteList"
                   Background="Transparent" BorderThickness="0" Foreground="#EEE"
                   FontFamily="Segoe UI" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Help}" Foreground="{StaticResource Glass.FgMuted}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>

    <Border x:Name="ChordOverlay"
            Visibility="Collapsed"
            Background="{StaticResource Glass.OverlayScrim}"
            Panel.ZIndex="101">
      <Border Width="480" MaxHeight="380"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource Glass.BgRaised}" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1"
              Padding="12" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="CascadeChord · melody" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Bottom"
                     Text="Ctrl+K · type alias (of/sf/h/…) · Enter · Esc · timeout 8s"
                     Foreground="{StaticResource Glass.FgMuted}" FontSize="11" Margin="0,8,0,0"/>
          <TextBox x:Name="ChordQuery"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Background="#222" Foreground="#EEE" BorderBrush="#3F3F46"
                   Padding="8" FontFamily="Consolas" FontSize="14"/>
          <ListBox x:Name="ChordList"
                   Background="Transparent" BorderThickness="0" Foreground="#EEE"
                   FontFamily="Segoe UI" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,3" Orientation="Horizontal">
                  <TextBlock Text="{Binding Alias}" FontFamily="Consolas" FontWeight="SemiBold" Width="36"/>
                  <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Help}" Foreground="{StaticResource Glass.FgMuted}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</Window>

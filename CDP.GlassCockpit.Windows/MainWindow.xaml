<Window x:Class="CDP.GlassCockpit.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="CDP GlassCockpit · Windows"
        Height="720" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="#1E1E1E"
        Foreground="#E0E0E0">
  <DockPanel>
    <StatusBar DockPanel.Dock="Bottom" Background="#252526" Foreground="#CCCCCC">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="glass · spike0 · latch idle" />
      </StatusBarItem>
      <StatusBarItem HorizontalAlignment="Right">
        <TextBlock Text="P | F=Intercom | M · AvalonDock+AvalonEdit · ADR-0021" />
      </StatusBarItem>
    </StatusBar>

    <avalonDock:DockingManager x:Name="DockManager" AllowMixedOrientation="True">
      <avalonDock:LayoutRoot>
        <avalonDock:LayoutPanel Orientation="Horizontal">
          <avalonDock:LayoutAnchorablePane DockWidth="280">
            <avalonDock:LayoutAnchorable Title="P · plan" CanClose="False" CanHide="False">
              <TextBox x:Name="PlanBox"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       VerticalScrollBarVisibility="Auto"
                       IsReadOnly="True"
                       Background="#252526"
                       Foreground="#E0E0E0"
                       BorderThickness="0"
                       Padding="8"
                       Text="Plan seat — latch / TM pulse later.&#x0a;&#x0a;GlassCockpit.Windows peel0." />
            </avalonDock:LayoutAnchorable>
          </avalonDock:LayoutAnchorablePane>

          <avalonDock:LayoutDocumentPane>
            <avalonDock:LayoutDocument Title="F · Intercom" CanClose="False">
              <DockPanel>
                <TextBlock DockPanel.Dock="Top"
                           Margin="8,6"
                           FontWeight="SemiBold"
                           Text="Forward = Intercom (long-form)" />
                <avalonEdit:TextEditor x:Name="IntercomEditor"
                                       FontFamily="Consolas"
                                       FontSize="14"
                                       ShowLineNumbers="False"
                                       WordWrap="True"
                                       Background="#1E1E1E"
                                       Foreground="#E0E0E0"
                       IsReadOnly="True" />
              </DockPanel>
            </avalonDock:LayoutDocument>
          </avalonDock:LayoutDocumentPane>

          <avalonDock:LayoutAnchorablePane DockWidth="300">
            <avalonDock:LayoutAnchorable Title="M · MFD" CanClose="False" CanHide="False">
              <ListBox x:Name="MfdPages"
                       Background="#252526"
                       Foreground="#E0E0E0"
                       BorderThickness="0"
                       Padding="4">
                <ListBoxItem Content="SolutionExplorer" IsSelected="True" />
                <ListBoxItem Content="Terminal" />
                <ListBoxItem Content="Build" />
                <ListBoxItem Content="Problems" />
                <ListBoxItem Content="Git" />
                <ListBoxItem Content="DebugStack" />
                <ListBoxItem Content="SemanticMap" />
                <ListBoxItem Content="Chat" />
              </ListBox>
            </avalonDock:LayoutAnchorable>
          </avalonDock:LayoutAnchorablePane>
        </avalonDock:LayoutPanel>
      </avalonDock:LayoutRoot>
    </avalonDock:DockingManager>
  </DockPanel>
</Window>

<Window x:Class="CDP.GlassCockpit.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:uikit="clr-namespace:CDP.GlassCockpit.Windows.UiKit"
        xmlns:local="clr-namespace:CDP.GlassCockpit.Windows"
        Title="CDP GlassCockpit · Windows"
        Height="800" Width="1400"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Glass.Bg}"
        Foreground="{StaticResource Glass.Fg}">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="GlassDarkCockpit.xaml"/>
        <ResourceDictionary Source="GlassChromeStyles.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>


  <Grid x:Name="ScaleRoot">
  <DockPanel>
    <!-- Top chrome (CIDE-like band) -->
    <Border DockPanel.Dock="Top" Background="{StaticResource Glass.BgRaised}" BorderBrush="{StaticResource Glass.BorderSoft}" BorderThickness="0,0,0,1" Padding="10,8">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <uikit:GlassStatusChip Text="ON GND" Level="Caution" Margin="0,0,6,0"/>
        <uikit:GlassStatusChip x:Name="TopologyBadge" Grid.Column="1" Text="(F)" Level="Quiet" Margin="0,0,6,0"/>
        <!-- Indication strip: GlassStatusChip band (UiKit adapt). Full SoftOrgan text in Tip. -->
        <Border Grid.Column="2" Background="{StaticResource Glass.BgPanel}" BorderBrush="{StaticResource Glass.Border}"
                BorderThickness="1" CornerRadius="4" Padding="0">
          <DockPanel>
            <Border DockPanel.Dock="Left" Width="2" Background="{StaticResource Glass.ElectricRail}"
                    CornerRadius="4,0,0,4" Margin="0,3,0,3"/>
            <DockPanel Margin="8,4">
              <uikit:GlassStatusChip x:Name="ChromeHintChip" DockPanel.Dock="Left" Text="CFG · 1×" Level="Quiet"
                                    Tip="click = UI scale 0.85/1/1.15/1.3 · settings.toml" Margin="0,0,6,0"
                                    Cursor="Hand" MouseLeftButtonUp="ChromeHintChip_OnClick"/>
              <StackPanel x:Name="SoftOrganBand" Orientation="Horizontal" Visibility="Collapsed">
                <ItemsControl x:Name="SoftOrganChips">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <uikit:GlassStatusChip Text="{Binding Label}" Tip="{Binding Tip}" Level="{Binding Level}"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="SoftOrganOverflowHost" Visibility="Collapsed"
                        Background="{StaticResource Glass.ChipQuietBg}"
                        BorderBrush="{StaticResource Glass.ChipQuietBorder}" BorderThickness="1" CornerRadius="3"
                        Padding="7,2" Cursor="Hand" MouseLeftButtonUp="SoftOrganOverflow_OnClick">
                  <TextBlock x:Name="SoftOrganOverflow" Text="" Foreground="{StaticResource Glass.ChipQuietFg}"
                             FontFamily="Consolas" FontSize="10" FontWeight="SemiBold"/>
                </Border>
              </StackPanel>
            </DockPanel>
          </DockPanel>
        </Border>
        <TextBlock Grid.Column="3" VerticalAlignment="Center" Margin="10,0,0,0"
                   Foreground="{StaticResource Glass.ElectricDim}" FontSize="10" FontFamily="Consolas" Text="GLASS"/>
      </Grid>
    </Border>

    <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Glass.BgRaised}" Foreground="{StaticResource Glass.FgMuted}">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="glass · idle"/>
      </StatusBarItem>
    </StatusBar>

    <!-- P | F | M — widths from GlassCore PresentationMainGridLayoutFrameBuilder -->
    <Grid x:Name="MainGrid" Margin="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="220"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="4"/>
        <ColumnDefinition Width="340"/>
      </Grid.ColumnDefinitions>

      <!-- P · one page (no nav list) — glance fills the instrument -->
      <Border x:Name="PfdZone" Grid.Column="0" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1" Background="#161616" Margin="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock x:Name="PfdZoneTitle" Text="P · Plan" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Glass.FgTitle}"/>
          </Border>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="12,10">
            <!-- Shared-SSOT Q1: WHY + NEXT instrument cards (not one PLAN text dump). -->
            <StackPanel>
              <uikit:GlassEcamReadout x:Name="PlanWhyReadout" Label="WHY" ValueText="—" Margin="0,0,0,8"/>
              <uikit:GlassEcamReadout x:Name="PlanNextReadout" Label="NEXT" ValueText="(no leaf)" Margin="0,0,0,8"/>
              <uikit:GlassEcamReadout x:Name="PlanCourseReadout" Label="COURSE" ValueText="—" Margin="0,0,0,8"/>
              <TextBlock Text="leaf board" FontSize="10" Foreground="#888" Margin="0,4,0,4"/>
              <UniformGrid Columns="3" Margin="0,0,0,8">
                <Border x:Name="PlanFlyCard" Margin="0,0,4,0" Padding="8,6" CornerRadius="4"
                        Background="#1A2430" BorderBrush="#4A9EFF" BorderThickness="1" Cursor="Hand">
                  <StackPanel>
                    <TextBlock Text="FLY" FontSize="9" Foreground="#888"/>
                    <TextBlock x:Name="PlanFlyCount" Text="0" FontSize="16" FontWeight="SemiBold"
                               FontFamily="Consolas" Foreground="#9EC8FF"/>
                  </StackPanel>
                </Border>
                <Border x:Name="PlanOpenCard" Margin="0,0,4,0" Padding="8,6" CornerRadius="4"
                        Background="#2A2618" BorderBrush="#D7A33C" BorderThickness="1" Cursor="Hand">
                  <StackPanel>
                    <TextBlock Text="OPEN" FontSize="9" Foreground="#888"/>
                    <TextBlock x:Name="PlanOpenCount" Text="0" FontSize="16" FontWeight="SemiBold"
                               FontFamily="Consolas" Foreground="#E0C878"/>
                  </StackPanel>
                </Border>
                <Border x:Name="PlanDoneCard" Padding="8,6" CornerRadius="4"
                        Background="#1A2E1A" BorderBrush="#3A3A3A" BorderThickness="1" Cursor="Hand">
                  <StackPanel>
                    <TextBlock Text="DONE" FontSize="9" Foreground="#888"/>
                    <TextBlock x:Name="PlanDoneCount" Text="0" FontSize="16" FontWeight="SemiBold"
                               FontFamily="Consolas" Foreground="#A8E0A8"/>
                  </StackPanel>
                </Border>
              </UniformGrid>
              <ListBox x:Name="PlanLeafBoardList" Background="Transparent" BorderThickness="0"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                       MaxHeight="280">
                <ListBox.ItemContainerStyle>
                  <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Background" Value="Transparent"/>
                  </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:PlanBoardLeaf}">
                    <Border Padding="8,6" CornerRadius="4" BorderThickness="1" BorderBrush="#22FFFFFF" Background="#12000000">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="4"/>
                          <ColumnDefinition Width="48"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="4" CornerRadius="2" Margin="0,0,8,0">
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="#D7A33C"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding Mark}" Value="FLY">
                                  <Setter Property="Background" Value="#4A9EFF"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mark}" Value="DONE">
                                  <Setter Property="Background" Value="#5A8F5A"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Mark}" Value="COURSE">
                                  <Setter Property="Background" Value="#888888"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding Mark}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#AAA" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                   TextWrapping="Wrap" Foreground="#DDD" VerticalAlignment="Center"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <!-- Legacy single dump kept collapsed for situ cache / latch paint mirror. -->
              <uikit:GlassEcamReadout x:Name="PlanReadout" Label="PLAN" ValueText="(no solution yet)" Visibility="Collapsed"/>
              <TextBlock x:Name="PlanTitle" Visibility="Collapsed" Text="(no solution yet)"/>
              <TextBlock x:Name="PlanMeta" Visibility="Collapsed"/>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="#222"/>

      <!-- F Intercom / Editor (primary_work_surface) -->
      <Border Grid.Column="2" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1" Background="#141414" Margin="0,4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="12,8" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <DockPanel>
              <TextBlock x:Name="ForwardTitle" DockPanel.Dock="Left" Text="F · Intercom" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Glass.FgTitle}" VerticalAlignment="Center"/>
              <TextBlock x:Name="IntercomSubtitle" HorizontalAlignment="Right" FontSize="11" Foreground="#888" VerticalAlignment="Center"/>
            </DockPanel>
          </Border>

          <!-- Intercom HUD: flat Korry + HDG/CRS + model (CIT-lit only) -->
          <Border DockPanel.Dock="Top" Background="#161A18" Padding="10,5" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <DockPanel>
              <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="AutoiKorryBtn" Content="AUTOI" Style="{StaticResource KorryBtn}"
                        Click="AutoiKorryBtn_OnClick" ToolTip="AutoIgnition · 2-state"/>
                <Button x:Name="HildKorryBtn" Content="HILD" Style="{StaticResource KorryBtn}"
                        Click="HildKorryBtn_OnClick" ToolTip="Human-in-loop detector · 2-state"/>
                <Button x:Name="VadKorryBtn" Content="VAD" Style="{StaticResource KorryBtn}"
                        Click="VadKorryBtn_OnClick" ToolTip="Voice activity · slot (not wired)"/>
              </StackPanel>
              <ComboBox x:Name="HudModelPicker" DockPanel.Dock="Right"
                        Width="140" Margin="12,0,0,0" VerticalAlignment="Center"
                        Background="#222" Foreground="#EEE" BorderBrush="#3F3F46"
                        FontSize="11" FontFamily="Consolas"
                        ToolTip="FM model · lit only when lane=CIT">
                <ComboBox.Resources>
                  <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#222222"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#EEEEEE"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#152028"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F0F0F0"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="#1A2830"/>
                  <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="#F0F0F0"/>
                </ComboBox.Resources>
                <ComboBox.ItemContainerStyle>
                  <Style TargetType="ComboBoxItem">
                    <Setter Property="Background" Value="#222"/>
                    <Setter Property="Foreground" Value="#EEE"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,4"/>
                  </Style>
                </ComboBox.ItemContainerStyle>
              </ComboBox>
              <TextBlock x:Name="HdgCrsText" Text="HDG/CRS · —" FontSize="11" FontFamily="Consolas"
                         Foreground="#A8C5B5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                         Margin="12,0,0,0"/>
            </DockPanel>
          </Border>

          <!-- ADR 0120: editor XOR intercom on Forward; when Forward=intercom, editor mounts on M -->
          <Grid x:Name="ForwardBody">
            <Grid.RowDefinitions>
              <RowDefinition x:Name="ForwardEditorRow" Height="2*"/>
              <RowDefinition x:Name="ForwardSplitRow" Height="4"/>
              <RowDefinition x:Name="ForwardIntercomRow" Height="*" MinHeight="180"/>
            </Grid.RowDefinitions>

            <ContentControl x:Name="ForwardEditorHost" Grid.Row="0">
              <Border x:Name="EditorChrome" Background="#0D1117">
                <DockPanel>
                  <Border DockPanel.Dock="Top" Background="#1A1A1A" Padding="10,4" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
                    <DockPanel>
                      <Button x:Name="SaveFileBtn" DockPanel.Dock="Right" Content="Save" Style="{StaticResource ChromeBtn}"
                              Click="SaveFileBtn_OnClick" ToolTip="Save (Ctrl+S)" Margin="8,0,0,0"/>
                      <Button x:Name="OpenFileBtn" DockPanel.Dock="Right" Content="Open…" Style="{StaticResource ChromeBtn}"
                              Click="OpenFileBtn_OnClick" ToolTip="Open a file (Ctrl+O)" Margin="8,0,0,0"/>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="EditorPathLabel" Text="(no file)" FontSize="11" Foreground="{StaticResource Glass.FgMuted}"
                                   FontFamily="Consolas" TextTrimming="CharacterEllipsis"/>
                        <StackPanel x:Name="EditorSituPanel" Margin="0,4,0,0" Visibility="Collapsed"
                                    ToolTip="Shared-SSOT · WHY-file instrument cards (not text ribbon)">
                          <TextBlock x:Name="EditorSituStatusLabel" Text="situ · card deck" FontSize="10"
                                     Foreground="{StaticResource Glass.FgMuted}" Margin="0,0,0,4"/>
                          <ItemsControl x:Name="EditorSituCardsPanel"/>
                        </StackPanel>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <avalonEdit:TextEditor x:Name="CodeEditor"
                                         FontFamily="Cascadia Code, Consolas, Courier New"
                                         FontSize="14.5"
                                         Background="#0D1117"
                                         Foreground="#E6EDF3"
                                         LineNumbersForeground="#6E7681"
                                         ShowLineNumbers="True"
                                         WordWrap="False"
                                         IsReadOnly="False"/>
                </DockPanel>
              </Border>
            </ContentControl>

            <GridSplitter x:Name="ForwardSplit" Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="#222"/>

            <DockPanel x:Name="IntercomSurface" Grid.Row="2">
              <Border DockPanel.Dock="Bottom" Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,1,0,0" Padding="10">
                <Grid>
                  <Popup x:Name="SlashPopup"
                         Placement="Top"
                         PlacementTarget="{Binding ElementName=ComposerBox}"
                         StaysOpen="False"
                         AllowsTransparency="True">
                    <Border Background="{StaticResource Glass.BgPanel}" BorderBrush="#3F3F46" BorderThickness="1" Padding="4" MaxHeight="220" MinWidth="280">
                      <ListBox x:Name="SlashList"
                               Background="Transparent"
                               BorderThickness="0"
                               Foreground="#EEE"
                               FontFamily="Consolas"
                               FontSize="12">
                        <ListBox.ItemTemplate>
                          <DataTemplate>
                            <StackPanel Margin="2,2">
                              <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                              <TextBlock Text="{Binding Help}" Foreground="{StaticResource Glass.FgMuted}" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                          </DataTemplate>
                        </ListBox.ItemTemplate>
                      </ListBox>
                    </Border>
                  </Popup>
                  <DockPanel>
                    <Button x:Name="SendBtn" DockPanel.Dock="Right" Content="Send" Style="{StaticResource ChromeBtn}"
                            Click="SendBtn_OnClick" ToolTip="Send (Enter / Ctrl+Enter; Shift+Enter = newline; / = slash)"/>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                      <Button x:Name="LaneCitBtn" Content="CIT" Style="{StaticResource KorryBtn}"
                              Click="LaneCitBtn_OnClick" ToolTip="Citizen · MAF / FM path"/>
                      <Button x:Name="LaneHostBtn" Content="HOST" Style="{StaticResource KorryBtn}"
                              Click="LaneHostBtn_OnClick" ToolTip="Composer · host"/>
                      <Button x:Name="LanePfBtn" Content="PF" Style="{StaticResource KorryBtn}"
                              Click="LanePfBtn_OnClick" ToolTip="PF · habitat partner"/>
                    </StackPanel>
                    <TextBox x:Name="ComposerBox"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             MinHeight="40" MaxHeight="120"
                             VerticalScrollBarVisibility="Auto"
                             Background="#222"
                             Foreground="#EEE"
                             BorderBrush="#3F3F46"
                             BorderThickness="1"
                             Padding="8"
                             FontFamily="Segoe UI"
                             FontSize="13"
                             Margin="0,0,8,0"
                             Text="Message @PF…"
                             PreviewKeyDown="ComposerBox_OnPreviewKeyDown"
                             GotKeyboardFocus="ComposerBox_OnGotKeyboardFocus"/>
                  </DockPanel>
                </Grid>
              </Border>

              <!-- Slack/MM Face: partner typing above composer (presence latch — not bubble invent). -->
              <TextBlock x:Name="TypingCue"
                         DockPanel.Dock="Bottom"
                         Text=""
                         FontSize="12"
                         FontStyle="Italic"
                         Foreground="#888"
                         Margin="14,0,14,4"
                         Visibility="Collapsed"
                         ToolTip="Partner presence · composing|busy"/>

              <Border DockPanel.Dock="Top" Background="{StaticResource Glass.BgRaised}" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1" Padding="8,6">
                <StackPanel>
                  <DockPanel>
                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0">
                      <Button x:Name="ChannelCrewBtn" Content="#crew" Style="{StaticResource KorryBtn}"
                              Click="ChannelCrewBtn_OnClick" ToolTip="#crew · humans+agents together (NorthStar hub)"/>
                      <Button x:Name="ChannelRadioBtn" Content="Radio" Style="{StaticResource KorryBtn}"
                              Click="ChannelRadioBtn_OnClick" ToolTip="Radio · operator ↔ this seat / citizen partner"/>
                      <Button x:Name="ChannelDmBtn" Content="DM" Style="{StaticResource KorryBtn}"
                              Click="ChannelDmBtn_OnClick" ToolTip="DM · 1:1 · address book (humans+agents)"/>
                    </StackPanel>
                    <Button x:Name="TopicAllBtn" DockPanel.Dock="Left" Content="Topics" Style="{StaticResource TopicAllBtnStyle}"
                            Click="TopicAllBtn_OnClick" ToolTip="Topic catalog · ADR 0072 · opt-in (Face: no card strip)" Margin="0,0,6,0" Tag="selected"/>
                    <Button x:Name="TopicBackBtn" DockPanel.Dock="Left" Content="Back" Style="{StaticResource ChromeBtn}"
                            Click="TopicBackBtn_OnClick" ToolTip="Back to topic overview (c:atb)" Margin="0,0,6,0" Visibility="Collapsed"/>
                    <TextBlock x:Name="TopicsEmptyHint" DockPanel.Dock="Left"
                               Text="(empty feed — send a message)"
                               FontSize="11" Foreground="#555" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <TextBlock x:Name="TopicsOverviewHint" DockPanel.Dock="Left"
                               Text="" FontSize="11" Foreground="#666" VerticalAlignment="Center" Margin="0,0,8,0"
                               Visibility="Collapsed"/>
                    <!-- Face: horizontal topic-card strip collapsed — catalog via Overview (ADR 0072). -->
                    <ScrollViewer x:Name="TopicCardStrip" Visibility="Collapsed"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                      <ItemsControl x:Name="TopicCards">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Button Content="{Binding Title}" Style="{StaticResource TopicCardBtn}"
                                    Margin="0,0,6,0" MaxWidth="280"
                                    ToolTip="{Binding Title}"
                                    Tag="{Binding Id}"
                                    Click="TopicCard_OnClick"/>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </ScrollViewer>
                  </DockPanel>
                  <TextBlock x:Name="ProductSpineStrip" Text="" FontSize="11" Foreground="#9AB"
                             Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"
                             ToolTip="ADR 0096 product spine"/>
                </StackPanel>
              </Border>

              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="FaceSideStack" Grid.Column="0" Orientation="Horizontal">
                <Border x:Name="DmContactsPanel" Width="168" Visibility="Collapsed"
                        Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="6,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Contacts" FontSize="11" FontWeight="SemiBold"
                               Foreground="#AAA" Margin="2,0,0,8"
                               ToolTip="DM address book · humans + agents equal standing"/>
                    <ListBox x:Name="DmContactList" Background="Transparent" BorderThickness="0"
                             Foreground="#DDD" FontSize="12" FontFamily="Segoe UI"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="DmContactList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Line}" Padding="4,3" TextTrimming="CharacterEllipsis"/>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
                <Border x:Name="CitModelsPanel" Width="168" Visibility="Collapsed"
                        Background="#1A1A1A" BorderBrush="#2A2A2A" BorderThickness="0,0,1,0" Padding="6,8">
                  <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Models" FontSize="11" FontWeight="SemiBold"
                               Foreground="#AAA" Margin="2,0,0,8"
                               ToolTip="FM model directory · CIT lane · sealed Cloud.ru shortlist"/>
                    <ListBox x:Name="CitModelList" Background="Transparent" BorderThickness="0"
                             Foreground="#DDD" FontSize="12" FontFamily="Consolas"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="CitModelList_OnSelectionChanged">
                      <ListBox.ItemTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding Line}" Padding="4,3" TextTrimming="CharacterEllipsis"
                                     ToolTip="{Binding Id}"/>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                  </DockPanel>
                </Border>
                </StackPanel>
                <ScrollViewer x:Name="TopicOverviewScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="12"
                              Visibility="Collapsed">
                  <StackPanel>
                    <TextBlock x:Name="TopicOverviewHeader" Text="Topics" FontSize="14" FontWeight="SemiBold"
                               Foreground="#CCC" Margin="0,0,0,10"/>
                    <ItemsControl x:Name="TopicOverviewCards">
                      <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                          <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                      </ItemsControl.ItemsPanel>
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Button Style="{StaticResource TopicOverviewCardBtn}"
                                  Margin="0,0,10,10" MinWidth="200" MaxWidth="320"
                                  Tag="{Binding Id}"
                                  Click="TopicCard_OnClick"
                                  ToolTip="{Binding Title}">
                            <StackPanel>
                              <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                              <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="#888" Margin="0,4,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </ScrollViewer>
                <ScrollViewer x:Name="FeedScroll" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="10"
                              ScrollChanged="FeedScroll_OnScrollChanged">
                  <ItemsControl x:Name="MessageFeed">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <!-- Face flat feed + ADR 0136: gutter · highlight · ПКМ select (CIDE port). -->
                        <Border Margin="0,0,0,10" Padding="6,4" BorderThickness="0"
                                HorizontalAlignment="Stretch">
                          <Border.ContextMenu>
                            <ContextMenu>
                              <MenuItem Header="{Binding Ordinal, StringFormat=Выбрать сообщение #{0}}"
                                        Click="MessageSelectMenu_OnClick"/>
                              <MenuItem Header="Сбросить выбор" Click="MessageSelectClearMenu_OnClick"/>
                            </ContextMenu>
                          </Border.ContextMenu>
                          <Border.Style>
                            <Style TargetType="Border">
                              <Setter Property="Background" Value="Transparent"/>
                              <Setter Property="BorderBrush" Value="Transparent"/>
                              <Setter Property="BorderThickness" Value="0"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                  <Setter Property="Background" Value="#1E3D30"/>
                                  <Setter Property="BorderBrush" Value="#3D8F6A"/>
                                  <Setter Property="BorderThickness" Value="0,0,0,0"/>
                                  <Setter Property="Padding" Value="6,4,6,4"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                  <Setter Property="Background" Value="#254A38"/>
                                  <Setter Property="BorderBrush" Value="#5BC48A"/>
                                  <Setter Property="BorderThickness" Value="3,0,0,0"/>
                                  <Setter Property="Padding" Value="3,4,6,4"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </Border.Style>
                          <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding OrdinalLabel}" Width="28"
                                       FontSize="11" FontFamily="Consolas" Foreground="#666"
                                       VerticalAlignment="Top" Margin="0,2,6,0"/>
                            <StackPanel>
                              <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="{Binding Role}" FontSize="12" FontWeight="SemiBold" Foreground="#D0D0D0"/>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding When}" FontSize="11" Foreground="#666" HorizontalAlignment="Right" Margin="12,0,0,0"/>
                              </DockPanel>
                              <local:GlassIntercomMarkdownBody Markdown="{Binding Body}"/>
                              <ItemsControl ItemsSource="{Binding Pointers}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Border Margin="0,0,8,4" Padding="10,8" MinWidth="160" CornerRadius="4"
                                            Background="#12201C" BorderBrush="#3D8F6A" BorderThickness="1"
                                            ToolTip="Radio · look at instrument">
                                      <StackPanel>
                                        <TextBlock Text="{Binding Label}" FontSize="10" Foreground="#7AA892"/>
                                        <TextBlock Text="{Binding Value}" FontSize="13" FontWeight="SemiBold"
                                                   FontFamily="Consolas" Foreground="#B8F0D0" TextWrapping="Wrap"
                                                   Margin="0,2,0,0"/>
                                      </StackPanel>
                                    </Border>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <ItemsControl ItemsSource="{Binding Chips}" Margin="0,6,0,0">
                                <ItemsControl.ItemsPanel>
                                  <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                  </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate>
                                    <Button Style="{StaticResource AttachChipBtn}"
                                            Content="{Binding Label}" Tag="{Binding}"
                                            Click="AttachChip_OnClick"
                                            ToolTip="{Binding Bracket}"/>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
                <Button x:Name="NewMsgCueBtn"
                        VerticalAlignment="Bottom" HorizontalAlignment="Center"
                        Margin="0,0,0,12"
                        Style="{StaticResource ChromeBtn}"
                        Background="{StaticResource Glass.SelectBg}" BorderBrush="{StaticResource Glass.SelectBorder}" Foreground="{StaticResource Glass.SelectFg}"
                        Visibility="Collapsed"
                        Click="NewMsgCueBtn_OnClick"
                        ToolTip="Jump to latest messages"/>
              </Grid>
            </DockPanel>
          </Grid>
        </DockPanel>
      </Border>

      <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="#222"/>

      <!-- M · one page fills instrument; page select via seats/palette (not mouse list) -->
      <Border x:Name="MfdZone" Grid.Column="4" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1" Background="#161616" Margin="4">
        <DockPanel>
          <Border DockPanel.Dock="Top" Background="#1E1E1E" Padding="10,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <TextBlock x:Name="MfdZoneTitle" Text="M · Terminal" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource Glass.FgTitle}"/>
          </Border>
          <Border DockPanel.Dock="Top" Background="{StaticResource Glass.BgRaised}" Padding="8,6" BorderBrush="#2A2A2A" BorderThickness="0,0,0,1">
            <DockPanel>
              <uikit:GlassSoftKeyBar x:Name="EicasSoftKeys" DockPanel.Dock="Right"
                                     Key1Text="clr" Key2Text="ack" Key3Text="list"
                                     Margin="12,0,0,0"/>
              <ItemsControl x:Name="MfdHealthBand">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal"/>
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </DockPanel>
          </Border>
          <!-- Catalog kept for SelectMfdPage / seats latch; not shown (aviation: one page on glass). -->
          <ListBox x:Name="MfdPages"
                   Visibility="Collapsed"
                   Width="0" Height="0"
                   SelectionChanged="MfdPages_OnSelectionChanged">
            <ListBoxItem Content="SolutionExplorer"/>
            <ListBoxItem Content="Terminal" IsSelected="True"/>
            <ListBoxItem Content="Build"/>
            <ListBoxItem Content="Tests"/>
            <ListBoxItem Content="Problems"/>
            <ListBoxItem Content="Git"/>
            <ListBoxItem Content="DebugStack"/>
            <ListBoxItem Content="SemanticMap"/>
            <ListBoxItem Content="HybridIndex"/>
            <ListBoxItem Content="RelatedFiles"/>
            <ListBoxItem Content="Correspondence"/>
            <ListBoxItem Content="MarkdownPreview"/>
            <ListBoxItem Content="QRH"/>
            <ListBoxItem Content="ECL"/>
            <ListBoxItem Content="Alert"/>
            <ListBoxItem Content="WebAiPortal"/>
            <ListBoxItem Content="AiChatSettings"/>
            <ListBoxItem Content="FlightDataStorage"/>
            <ListBoxItem Content="DomainBoard"/>
            <ListBoxItem Content="WorkspaceHealth"/>
            <ListBoxItem Content="EnvironmentReadiness"/>
            <ListBoxItem Content="Events"/>
            <ListBoxItem Content="Hypotheses"/>
            <ListBoxItem Content="Chat"/>
            <ListBoxItem Content="Editor"/>
          </ListBox>
          <Grid>
            <TextBlock x:Name="MfdBody" TextWrapping="Wrap" FontSize="13" Foreground="#CCCCCC"
                       Margin="12" Text="Select an MFD page."/>
            <TreeView x:Name="MfdSolutionExplorerTree" Visibility="Collapsed"
                      Margin="8" FontSize="13" Background="Transparent" BorderThickness="0"
                      Foreground="#CCCCCC"
                      MouseDoubleClick="MfdSolutionExplorerTree_OnMouseDoubleClick"/>
            <ContentControl x:Name="MfdEditorHost" Visibility="Collapsed"/>
            <local:GlassMfdProcessHosts x:Name="MfdHosts"/>
          </Grid>
        </DockPanel>
      </Border>
    </Grid>
  </DockPanel>

    <local:GlassFloatingOverlays x:Name="Overlays"/>
  </Grid>
</Window>

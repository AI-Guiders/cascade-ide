<UserControl x:Class="CDP.GlassCockpit.Windows.GlassFloatingOverlays"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <Border x:Name="PaletteOverlay"
            Visibility="Collapsed"
            Background="{StaticResource Glass.OverlayScrim}"
            Panel.ZIndex="100">
      <Border Width="520" MaxHeight="420"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource Glass.BgRaised}" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1"
              Padding="12" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="Command palette" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Bottom" Text="Ctrl+Q toggle · Esc close · Enter run"
                     Foreground="{StaticResource Glass.FgMuted}" FontSize="11" Margin="0,8,0,0"/>
          <TextBox x:Name="PaletteQuery"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   Background="#222" Foreground="#EEE" BorderBrush="#3F3F46"
                   Padding="8" FontFamily="Segoe UI" FontSize="13"/>
          <ListBox x:Name="PaletteList"
                   Background="Transparent" BorderThickness="0" Foreground="#EEE"
                   FontFamily="Segoe UI" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,3">
                  <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                  <TextBlock Text="{Binding Help}" Foreground="{StaticResource Glass.FgMuted}" FontSize="11" TextWrapping="Wrap"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>

    <Border x:Name="ChordOverlay"
            Visibility="Collapsed"
            Background="{StaticResource Glass.OverlayScrim}"
            Panel.ZIndex="101">
      <Border Width="480" MaxHeight="380"
              VerticalAlignment="Center" HorizontalAlignment="Center"
              Background="{StaticResource Glass.BgRaised}" BorderBrush="{StaticResource Glass.Border}" BorderThickness="1"
              Padding="12" CornerRadius="4">
        <DockPanel>
          <TextBlock DockPanel.Dock="Top" Text="CascadeChord · melody" FontWeight="SemiBold" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Bottom"
                     Text="Ctrl+K · live tail (gs/els:10/wai:url) · Enter · Esc · timeout 8s"
                     Foreground="{StaticResource Glass.FgMuted}" FontSize="11" Margin="0,8,0,0"/>
          <TextBox x:Name="ChordQuery"
                   DockPanel.Dock="Top"
                   Margin="0,0,0,8"
                   IsReadOnly="True" IsTabStop="False" Focusable="False"
                   Background="#222" Foreground="#EEE" BorderBrush="#3F3F46"
                   Padding="8" FontFamily="Consolas" FontSize="14"/>
          <ListBox x:Name="ChordList"
                   Background="Transparent" BorderThickness="0" Foreground="#EEE"
                   FontFamily="Segoe UI" FontSize="12">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <StackPanel Margin="2,3" Orientation="Horizontal">
                  <TextBlock Text="{Binding Alias}" FontFamily="Consolas" FontWeight="SemiBold" Width="56"/>
                  <StackPanel>
                    <TextBlock Text="{Binding CommandId}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Help}" Foreground="{StaticResource Glass.FgMuted}" FontSize="11" TextWrapping="Wrap"/>
                  </StackPanel>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>

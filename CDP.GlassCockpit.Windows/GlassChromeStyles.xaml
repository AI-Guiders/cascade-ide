<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="ChromeBtn" TargetType="Button">
    <Setter Property="Background" Value="#2A2A2A"/>
    <Setter Property="Foreground" Value="#DDDDDD"/>
    <Setter Property="BorderBrush" Value="#3F3F46"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="10,4"/>
    <Setter Property="Margin" Value="0,0,6,0"/>
    <Setter Property="FontFamily" Value="Segoe UI"/>
    <Setter Property="FontSize" Value="12"/>
  </Style>
  <Style x:Key="TopicCardBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
    <Style.Triggers>
      <DataTrigger Binding="{Binding IsSelected}" Value="True">
        <Setter Property="Background" Value="{StaticResource Glass.SelectBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Glass.SelectBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource Glass.SelectFg}"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="TopicAllBtnStyle" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
    <Style.Triggers>
      <Trigger Property="Tag" Value="selected">
        <Setter Property="Background" Value="{StaticResource Glass.SelectBg}"/>
        <Setter Property="BorderBrush" Value="{StaticResource Glass.SelectBorder}"/>
        <Setter Property="Foreground" Value="{StaticResource Glass.SelectFg}"/>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="AttachChipBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
    <Setter Property="Margin" Value="0,0,6,4"/>
    <Setter Property="Padding" Value="8,2"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background" Value="#1E3A2F"/>
    <Setter Property="BorderBrush" Value="#3D8F6A"/>
    <Setter Property="Foreground" Value="#B8F0D0"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding Resolved}" Value="False">
        <Setter Property="Background" Value="#3A2222"/>
        <Setter Property="BorderBrush" Value="#8A4A4A"/>
        <Setter Property="Foreground" Value="#F0B8B8"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
</ResourceDictionary>
